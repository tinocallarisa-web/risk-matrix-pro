{
    "dataRoles": [
        {
            "displayName": "Risk",
            "displayNameKey": "Role_Risk",
            "name": "risk",
            "kind": "Grouping",
            "description": "One row per risk: its ID or name. Each risk becomes one marker."
        },
        {
            "displayName": "Category",
            "displayNameKey": "Role_Category",
            "name": "category",
            "kind": "Grouping",
            "description": "Optional. Colours the markers and builds the legend (e.g. risk type, owner, status)."
        },
        {
            "displayName": "Likelihood",
            "displayNameKey": "Role_Likelihood",
            "name": "likelihood",
            "kind": "Measure",
            "description": "Horizontal position. Either a level from 1 to the grid size, or a probability between 0 and 1."
        },
        {
            "displayName": "Impact",
            "displayNameKey": "Role_Impact",
            "name": "impact",
            "kind": "Measure",
            "description": "Vertical position. Either a level from 1 to the grid size, or a value between 0 and 1."
        },
        {
            "displayName": "Residual likelihood (Pro)",
            "displayNameKey": "Role_ResidualLikelihood",
            "name": "residualLikelihood",
            "kind": "Measure",
            "description": "Optional. Likelihood after mitigation. With residual impact, draws an arrow from the inherent to the residual position."
        },
        {
            "displayName": "Residual impact (Pro)",
            "displayNameKey": "Role_ResidualImpact",
            "name": "residualImpact",
            "kind": "Measure",
            "description": "Optional. Impact after mitigation."
        },
        {
            "displayName": "Target likelihood (Pro)",
            "displayNameKey": "Role_TargetLikelihood",
            "name": "targetLikelihood",
            "kind": "Measure",
            "description": "Optional. Likelihood you aim to reach once the planned actions are done."
        },
        {
            "displayName": "Target impact (Pro)",
            "displayNameKey": "Role_TargetImpact",
            "name": "targetImpact",
            "kind": "Measure",
            "description": "Optional. Impact you aim to reach once the planned actions are done."
        },
        {
            "displayName": "Tooltips",
            "displayNameKey": "Role_Tooltips",
            "name": "tooltips",
            "kind": "Measure",
            "description": "Optional. Extra measures shown in the tooltip, with their model format."
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "risk": {
                        "max": 1
                    },
                    "category": {
                        "max": 1
                    },
                    "likelihood": {
                        "max": 1
                    },
                    "impact": {
                        "max": 1
                    },
                    "residualLikelihood": {
                        "max": 1
                    },
                    "residualImpact": {
                        "max": 1
                    },
                    "tooltips": {
                        "max": 5
                    },
                    "targetLikelihood": {
                        "max": 1
                    },
                    "targetImpact": {
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "bind": {
                                "to": "risk"
                            }
                        },
                        {
                            "bind": {
                                "to": "category"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 1000
                        }
                    }
                },
                "values": {
                    "select": [
                        {
                            "bind": {
                                "to": "likelihood"
                            }
                        },
                        {
                            "bind": {
                                "to": "impact"
                            }
                        },
                        {
                            "bind": {
                                "to": "residualLikelihood"
                            }
                        },
                        {
                            "bind": {
                                "to": "residualImpact"
                            }
                        },
                        {
                            "bind": {
                                "to": "targetLikelihood"
                            }
                        },
                        {
                            "bind": {
                                "to": "targetImpact"
                            }
                        },
                        {
                            "bind": {
                                "to": "tooltips"
                            }
                        }
                    ]
                }
            }
        }
    ],
